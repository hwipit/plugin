[
  { "name": "ordinary build command runs untouched",
    "command": "npm run build", "expect": "no" },
  { "name": "reading files is never gated",
    "command": "cat src/index.ts", "expect": "no" },
  { "name": "a plain rm of one file is not the pattern",
    "command": "rm dist/bundle.js", "expect": "no" },
  { "name": "grep for the word deploy in source is not a deploy",
    "command": "grep -rn deploy src/", "expect": "no" },
  { "name": "git push to a feature branch is ordinary",
    "command": "git push origin feat/thing", "expect": "no" },

  { "name": "recursive force delete",
    "command": "rm -rf ./dist", "expect": "yes" },
  { "name": "recursive force delete, flags reversed",
    "command": "rm -fr /tmp/x", "expect": "yes" },
  { "name": "recursive force delete, separate flags",
    "command": "rm -r -f build", "expect": "yes" },
  { "name": "recursive force delete, long flags",
    "command": "rm --recursive --force node_modules", "expect": "yes" },

  { "name": "force push, long flag",
    "command": "git push --force origin main", "expect": "yes" },
  { "name": "force push, short flag",
    "command": "git push -f", "expect": "yes" },
  { "name": "force-with-lease is still a force push",
    "command": "git push --force-with-lease origin develop", "expect": "yes" },
  { "name": "hard reset throws away working state",
    "command": "git reset --hard HEAD~3", "expect": "yes" },
  { "name": "clean -fd deletes untracked work",
    "command": "git clean -fd", "expect": "yes" },

  { "name": "cdk deploy reaches real infrastructure",
    "command": "cdk deploy --context stage=prod", "expect": "yes" },
  { "name": "serverless deploy",
    "command": "serverless deploy --stage prod", "expect": "yes" },
  { "name": "terraform apply",
    "command": "terraform apply -auto-approve", "expect": "yes" },
  { "name": "a package script whose name contains deploy",
    "command": "yarn server:deploy:prod", "expect": "yes" },
  { "name": "npm run deploy",
    "command": "npm run deploy", "expect": "yes" },

  { "name": "dropping a table",
    "command": "psql -c 'DROP TABLE users'", "expect": "yes" },
  { "name": "dropping a database, lowercase",
    "command": "mysql -e 'drop database app'", "expect": "yes" },
  { "name": "truncating a table",
    "command": "psql -c 'TRUNCATE TABLE events'", "expect": "yes" },
  { "name": "deleting a dynamodb table",
    "command": "aws dynamodb delete-table --table-name hwip", "expect": "yes" },
  { "name": "redis flushall",
    "command": "redis-cli FLUSHALL", "expect": "yes" },

  { "name": "an empty command asks for nothing",
    "command": "", "expect": "no" }
]
