[
  { "name": "ordinary build command runs untouched",
    "command": "npm run build", "expect": "no" },
  { "name": "reading files is never gated",
    "command": "cat src/index.ts", "expect": "no" },
  { "name": "a plain rm of one file is not the pattern",
    "command": "rm dist/bundle.js", "expect": "no" },
  { "name": "grep for the word deploy in source is not a deploy",
    "command": "grep -rn deploy src/", "expect": "no" },
  { "name": "git push to a feature branch is ordinary",
    "command": "git push origin feat/thing", "expect": "no" },

  { "name": "recursive force delete",
    "command": "rm -rf ./dist", "expect": "yes" },
  { "name": "recursive force delete, flags reversed",
    "command": "rm -fr /tmp/x", "expect": "yes" },
  { "name": "recursive force delete, separate flags",
    "command": "rm -r -f build", "expect": "yes" },
  { "name": "recursive force delete, long flags",
    "command": "rm --recursive --force node_modules", "expect": "yes" },

  { "name": "force push, long flag",
    "command": "git push --force origin main", "expect": "yes" },
  { "name": "force push, short flag",
    "command": "git push -f", "expect": "yes" },
  { "name": "force-with-lease is still a force push",
    "command": "git push --force-with-lease origin develop", "expect": "yes" },
  { "name": "hard reset throws away working state",
    "command": "git reset --hard HEAD~3", "expect": "yes" },
  { "name": "clean -fd deletes untracked work",
    "command": "git clean -fd", "expect": "yes" },

  { "name": "cdk deploy reaches real infrastructure",
    "command": "cdk deploy --context stage=prod", "expect": "yes" },
  { "name": "serverless deploy",
    "command": "serverless deploy --stage prod", "expect": "yes" },
  { "name": "terraform apply",
    "command": "terraform apply -auto-approve", "expect": "yes" },
  { "name": "a package script whose name contains deploy",
    "command": "yarn server:deploy:prod", "expect": "yes" },
  { "name": "npm run deploy",
    "command": "npm run deploy", "expect": "yes" },

  { "name": "dropping a table",
    "command": "psql -c 'DROP TABLE users'", "expect": "yes" },
  { "name": "dropping a database, lowercase",
    "command": "mysql -e 'drop database app'", "expect": "yes" },
  { "name": "truncating a table",
    "command": "psql -c 'TRUNCATE TABLE events'", "expect": "yes" },
  { "name": "deleting a dynamodb table",
    "command": "aws dynamodb delete-table --table-name hwip", "expect": "yes" },
  { "name": "redis flushall",
    "command": "redis-cli FLUSHALL", "expect": "yes" },

  { "name": "git push -fu is a force push",
    "command": "git push -fu origin feat", "expect": "yes" },
  { "name": "git push -uf is a force push",
    "command": "git push -uf origin feat", "expect": "yes" },
  { "name": "+refspec force pushes",
    "command": "git push origin +feat", "expect": "yes" },
  { "name": "deleting a remote branch",
    "command": "git push origin --delete feat", "expect": "yes" },
  { "name": "backslash line continuation before --force",
    "command": "git push origin feat \\\n  --force", "expect": "yes" },
  { "name": "git push -u alone is ordinary",
    "command": "git push -u origin feat", "expect": "no" },
  { "name": "git -C before push --force",
    "command": "git -C /r push --force origin x", "expect": "yes" },
  { "name": "git -c k=v before reset --hard",
    "command": "git -c core.x=1 reset --hard HEAD~3", "expect": "yes" },
  { "name": "git -C and -c before push -f",
    "command": "git -C /r -c a=b push -f", "expect": "yes" },
  { "name": "terraform -chdir before apply",
    "command": "terraform -chdir=infra apply", "expect": "yes" },
  { "name": "git clean -x -f",
    "command": "git clean -x -f", "expect": "yes" },
  { "name": "absolute path /bin/rm -rf",
    "command": "/bin/rm -rf build", "expect": "yes" },
  { "name": "absolute path /usr/bin/rm -rf",
    "command": "/usr/bin/rm -rf build", "expect": "yes" },
  { "name": "rm -r then ls -f is not rm -rf",
    "command": "rm -r build; ls -f", "expect": "no" },
  { "name": "grep -rf then plain rm is not rm -rf",
    "command": "grep -rf pat.txt src/; rm tmp", "expect": "no" },
  { "name": "git clean -nd is a dry run",
    "command": "git clean -nd", "expect": "no" },
  { "name": "git clean --dry-run -fd is a dry run",
    "command": "git clean --dry-run -fd", "expect": "no" },
  { "name": "DROP TABLE split over lines",
    "command": "psql -c \"DROP\nTABLE users\"", "expect": "yes" },
  { "name": "rm -rf in a later segment",
    "command": "cd x && rm -rf build", "expect": "yes" },

  { "name": "reset --hard inside bash -c quotes",
    "command": "bash -c \"git reset --hard\"", "expect": "yes" },
  { "name": "reset --hard inside a command substitution",
    "command": "x=$(git reset --hard)", "expect": "yes" },
  { "name": "terraform apply inside quotes",
    "command": "bash -c \"terraform apply\"", "expect": "yes" },
  { "name": "push --delete inside single quotes over ssh",
    "command": "ssh h 'git push origin feat --delete'", "expect": "yes" },
  { "name": "git clean --force",
    "command": "git clean --force", "expect": "yes" },
  { "name": "git clean --force --dry-run is a dry run",
    "command": "git clean --force -n", "expect": "no" },

  { "name": "an empty command asks for nothing",
    "command": "", "expect": "no" }
]
